# ============================================================
# UniPath — Environment Variables Template
# ============================================================
# HOW TO USE:
#   1. Copy this file and rename it to ".env"  (no .example)
#   2. Fill in the values below with your real credentials
#   3. NEVER commit your ".env" file — it is in .gitignore
#   4. Get the real values from your team lead / Supabase dashboard
# ============================================================

# ----------------------------------------------------------
# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
# ----------------------------------------------------------

# Your Supabase project URL
# Example: https://xyzxyzxyz.supabase.co
SUPABASE_URL=your_supabase_project_url_here

# Your Supabase anonymous/public API key (safe for mobile clients)
# Found under: Project Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=your_supabase_anon_key_here
